# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=geo_risk
MONGO_COLLECTION=geo_events

# API keys (optional — sources skipped if missing)
NEWSAPI_KEY=
GNEWS_KEY=

# Ingestion
INGEST_INTERVAL_SECONDS=180
MAX_EVENT_AGE_HOURS=72
MAX_FRESHNESS_MINUTES=10

# Analysis
ROUTE_BUFFER_KM=50
MIN_LABEL_CONFIDENCE=0.50
ZONE_WEIGHT=0.30
EVENT_WEIGHT=0.70

# Log10: Time-decay + Intelligence
RECENCY_HALF_LIFE_DAYS=1.0
CORROBORATION_BOOST=1.15
SINGLE_SOURCE_PENALTY=0.90
TTL_EXPIRY_SECONDS=259200

# Logging
LOG_LEVEL=INFO

# Production API
APP_ENV=production
API_TIMEOUT_SECONDS=45
MAX_REQUEST_BYTES=65536
CORS_ALLOW_ORIGINS=*

# Log15: Quota-Aware Scheduling
# Daily quota budgets (requests/day) — conservative, under free-tier caps
NEWSAPI_DAILY_QUOTA=50
GNEWS_DAILY_QUOTA=50
GDELT_DAILY_QUOTA=500

# Log15: Source-specific fetch intervals (seconds)
# RSS: every 3 min, GDELT: every 15 min, APIs: every 30 min
RSS_INTERVAL_SECONDS=180
GDELT_INTERVAL_SECONDS=900
NEWSAPI_INTERVAL_SECONDS=1800
GNEWS_INTERVAL_SECONDS=1800

# Log15: Quota exhaustion cooldown (seconds)
QUOTA_EXHAUSTION_COOLDOWN=3600

# Log15: GDELT Rate Limiting
GDELT_MAX_RETRIES=5
GDELT_BASE_BACKOFF=3.0
GDELT_MAX_BACKOFF=120.0
GDELT_COOLDOWN_DURATION=600.0
